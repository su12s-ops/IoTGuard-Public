# Operator supplied real asset inventory: keep local, never stage or commit.
/asset_inventory.json

# ── 真实凭据与本地环境（绝不提交）────────────────────────────────
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── 运行数据 ──────────────────────────────────────────────────────
backend/data/
reports/
# 本地归档（原 Private 仓库证据/数据/凭据备份），绝不提交
local-archive/

# ── 密钥与虚拟机文件（防御性规则，正常开发不产生） ────────────────
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.vmdk
*.vmx
*.vmem
*.iso
*.img
# New local VM configurations are generated outside the source tree by default.
/deploy/generated/

# ── 工具与测试缓存 ────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mimosa/
frontend/test-results/
frontend/dist/
frontend/node_modules/
node_modules/
backend/package-lock.json
# 本地构建/测试临时目录（docker 构建日志、隔离测试库）
.dsh-tmp/

# ── 其他运行产物 ──────────────────────────────────────────────────
collector/sample_asset_outputs/
# 原生 eBPF 传感器本地编译产物（guard.bpf.o / vmlinux.h / iotguard-sensor）
collector/native/build/
*.log
