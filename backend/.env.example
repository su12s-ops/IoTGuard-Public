# Keep the configured model name in delivery; provide secrets at runtime.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Leave unset to use backend/data/linuxguard.db (also works in the container).
# LINUXGUARD_DATABASE_URL=sqlite:////app/data/linuxguard.db
LINUXGUARD_ARCHIVE_ON_STARTUP=0
NVD_API_KEY=
CANONICAL_CACHE_TTL_HOURS=24
NVD_CACHE_TTL_HOURS=168
CISA_KEV_CACHE_TTL_HOURS=24
EPSS_CACHE_TTL_HOURS=24

# IoT control: configure locally before discovery/SSH/task operations.
LINUXGUARD_CONTROL_TOKEN=
LINUXGUARD_DISCOVERY_CIDRS=
LINUXGUARD_DEVICE_GATEWAY_PASSWORD=
LINUXGUARD_ENABLE_DEVICE_REPAIR=0
LINUXGUARD_REPAIR_MANIFEST=

# Internet authorized-target scanning (stage 6): caps enforced server-side.
# Add your OWN authorized host CIDRs (e.g. 203.0.113.10/32) to LINUXGUARD_DISCOVERY_CIDRS too.
# LINUXGUARD_SCAN_MAX_PORTS=128
# LINUXGUARD_SCAN_TIMEOUT=2.5
# LINUXGUARD_SCAN_WORKERS=16

# Keep existing VM endpoints and ports. Supply their password locally.
VM_PASS=
# Demo SSH (routers/demo.py) pins the host key: SHA256:Base64 (43 chars) from
# ssh-keyscan, verified over a trusted channel. Unset = demo SSH refuses to connect.
VM_HOSTKEY_SHA256=
