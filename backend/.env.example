# Keep the configured model name in delivery; provide secrets at runtime.
# Variable names keep the DEEPSEEK_* prefix for zero-migration compatibility;
# any OpenAI-compatible or Anthropic Messages endpoint works via the protocol flag.
DEEPSEEK_API_KEY=
# Current provider: BigModel GLM-5.3-Flash on the Anthropic Messages endpoint
# (subscription-billed path). The OpenAI-compatible /api/paas/v4 endpoint is
# pay-as-you-go and NOT covered by that subscription (HTTP 1113 without balance).
DEEPSEEK_MODEL=glm-5.3-flash
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/anthropic
# openai = OpenAI-compatible /chat/completions | anthropic = Messages protocol
DEEPSEEK_API_PROTOCOL=anthropic
# Optional knob: "off" disables model thinking on the anthropic protocol.
# Default empty = model-native behavior (recommended: measured faster overall
# on long structured reports because thinking compresses the reasoning).
# DEEPSEEK_THINKING=off
# Leave unset to use backend/data/linuxguard.db (also works in the container).
# LINUXGUARD_DATABASE_URL=sqlite:////app/data/linuxguard.db
# 1 = 后端启动时先写结果存档，再清理衍生数据（设备与采集配置保留）。
# 本地 scripts/run_local_backend.py 会强制为 0，避免重启误清；Compose/生产可显式开启。
LINUXGUARD_ARCHIVE_ON_STARTUP=0
# 结果存档目录；留空使用 backend/data/archives。
# REPORT_ARCHIVE_DIR=
NVD_API_KEY=
CANONICAL_CACHE_TTL_HOURS=24
NVD_CACHE_TTL_HOURS=168
CISA_KEV_CACHE_TTL_HOURS=24
EPSS_CACHE_TTL_HOURS=24

# IoT control: configure locally before discovery/SSH/task operations.
LINUXGUARD_CONTROL_TOKEN=
LINUXGUARD_DISCOVERY_CIDRS=
LINUXGUARD_DEVICE_GATEWAY_PASSWORD=
# OpenWrt device-write master switch. The isolated Ubuntu clone lab path does
# NOT consult it (Stage 10 permission contract): the two write domains are
# disjoint, so one approval can never enable the other.
LINUXGUARD_ENABLE_DEVICE_REPAIR=0
# Ubuntu isolated-clone lab writes require ALL of: this switch =1, the exact
# clone asset id declared in LINUXGUARD_UBUNTU_LAB_ASSET_SCOPE, exact-plan
# approval, existing risk authorization and an operator-issued permit on
# backend + node. Keep disabled until separate explicit isolated-experiment
# approval; an empty scope is fail-closed even if the switch is flipped.
LINUXGUARD_ENABLE_UBUNTU_LAB_REPAIR=0
# Comma-separated asset ids whose lab repair may ever run on THIS backend.
# Production keeps this empty; only an isolated experiment backend declares
# its own clone asset id here.
LINUXGUARD_UBUNTU_LAB_ASSET_SCOPE=
LINUXGUARD_UBUNTU_LAB_PERMIT=
# Permit JSON: asset_id, machine_id_sha256, plan_hash, isolated_clone=true,
# restore_verified=true, snapshot_id, approved_by, expires_at (Unix seconds).
# Do not put permit files or credentials in Git; no automatic snapshot restore.
LINUXGUARD_REPAIR_MANIFEST=
# OpenWrt isolated-lab writes are disabled in standard deployment.
# A nonempty, exact asset-id scope is required when this lab switch is enabled.
# Keep both fields disabled/empty until the specific repair plan is authorized.
LINUXGUARD_ENABLE_OPENWRT_LAB_REPAIR=0
LINUXGUARD_OPENWRT_LAB_ASSET_SCOPE=
# M5 sole formal pipeline. off/shadow refuse formal requests; no legacy fallback.
LINUXGUARD_UNIFIED_PIPELINE=on

# Optional registered Linux collection node. Keep real tokens in the local env.
# Windows delegates; SSH key paths are resolved on the Linux node, not Windows.
LINUXGUARD_COLLECTION_NODE_ID=
LINUXGUARD_COLLECTION_NODE_TOKEN=
# Set only for a registered Ubuntu asset physically running this node.
LINUXGUARD_COLLECTION_NODE_LOCAL_ASSET_ID=
# Optional read-only logread schedule, existing registered connection IDs only.
# Empty disables it. Interval is clamped to 60..3600 seconds; at most two
# attempts per window, shared asset lock, 900s timeout, persisted dedup.
LINUXGUARD_OPENWRT_LOG_CONNECTION_IDS=
LINUXGUARD_OPENWRT_LOG_INTERVAL_S=60
# Optional extra pull nodes for isolated clone experiments (Stage 10). JSON array
# of {"id": "...", "local_asset_ids": "a,b"}; each extra node authenticates with
# its own LINUXGUARD_COLLECTION_NODE_TOKEN_<SUFFIX> variable derived from its id.
# Absent keeps single-node behaviour. Never point an extra node at production assets.
# LINUXGUARD_COLLECTION_NODES_JSON=
# Node runner: LINUXGUARD_NODE_TOKEN must equal COLLECTION_NODE_TOKEN.
# LINUXGUARD_NODE_BACKEND_URL and LINUXGUARD_NODE_ALLOWED_BACKEND_HOSTS are required.

# Internet authorized-target scanning (stage 6): caps enforced server-side.
# Add your OWN authorized host CIDRs (e.g. 203.0.113.10/32) to LINUXGUARD_DISCOVERY_CIDRS too.
# LINUXGUARD_SCAN_MAX_PORTS=128
# LINUXGUARD_SCAN_TIMEOUT=2.5
# LINUXGUARD_SCAN_WORKERS=16

# Keep existing VM endpoints and ports. Supply their password locally.
VM_PASS=
# Demo SSH (routers/demo.py) pins the host key: SHA256:Base64 (43 chars) from
# ssh-keyscan, verified over a trusted channel. Unset = demo SSH refuses to connect.
VM_HOSTKEY_SHA256=

# OpenWrt writes also require persistent operator enrollment via assets/{id}/repair-domain.
# Inventory/environment scopes never assign the production/openwrt_lab domain.
# Demo targets store this variable NAME only; set the value in a local secret environment.
LINUXGUARD_DEMO_PRIMARY=
