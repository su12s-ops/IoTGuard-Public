[Unit]
Description=LinuxGuard Falco standing runtime capture (observe-only)
Documentation=file:///opt/linuxguard/collector/deploy/falco/README.md
# 与发行版自带的 falco 常驻服务互斥：启动前停用，失败时恢复策略见 README 回滚节
Conflicts=falco-modern-bpf.service falco.service falco-custom.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 需 root：加载 eBPF 探针。环境变量由 /etc/linuxguard/falco.env 提供（不落源码）
EnvironmentFile=-/etc/linuxguard/falco.env
ExecStartPre=/bin/sh -c '! systemctl is-active --quiet falco-modern-bpf.service || systemctl stop falco-modern-bpf.service'
ExecStart=/opt/linuxguard/collector/deploy/falco/run_standing_capture.sh /var/lib/linuxguard/falco
# 常驻转发器可能因网络中断以 1（spool 待续传）退出；同样需要自动恢复。
# systemctl stop 的显式停止仍不会触发 Restart=always。
Restart=always
RestartSec=10
# 停止语义：SIGINT 广播到整个 cgroup —— python 转发器经 KeyboardInterrupt
# 走 finally（stopped 心跳 + spool 对账）；falco 同信号写出退出摘要
# （真实 drops 计数）。30s 后仍未退出才 SIGKILL。
TimeoutStopSec=30
KillMode=control-group
KillSignal=SIGINT
# 转发器在"存在未确认/spool 残留"时按设计返回 1（P0 诚实退出码）——
# 这是待续传信号而非崩溃；单元态按成功处理，spool 由 reliability 端点呈现。
SuccessExitStatus=1

[Install]
WantedBy=multi-user.target
