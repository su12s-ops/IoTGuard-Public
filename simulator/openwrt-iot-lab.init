#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local root=/opt/iotguard-lan id
    /usr/bin/python3 "$root/openwrt_lan.py" prepare || return 1
    for id in $(/usr/bin/python3 "$root/openwrt_lan.py" list); do
        procd_open_instance "$id-dhcp"
        procd_set_param command /sbin/ip netns exec "ig-$id" /sbin/udhcpc -f -i eth0 -s "$root/udhcpc.script" -p "/var/run/iotguard-$id-dhcp.pid" -x "hostname:iotguard-$id"
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
        procd_open_instance "$id-device"
        procd_set_param command /sbin/ip netns exec "ig-$id" /usr/bin/python3 "$root/lan_device.py" --device "$id"
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_set_param file "$root/lan_devices.json"
        procd_close_instance
    done
}
